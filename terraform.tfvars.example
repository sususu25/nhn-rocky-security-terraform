# terraform.tfvars.example

exposure_mode = "fip" or "lb"
service_target_port = TARGET_PORT_No. #lb를 사용할 경우 적용됨


lb_vip_address = "YOUR_VIP" #지정 불필요할 경우 ""혹은 주석처리 요망
#mgmt_fixed_ips = ["Fixed_IP", "Fixed_IP", "Fixed_IP"] # mgmt 고정이 필요할 경우 사용

region     = "KR1"
auth_url   = "https://api-identity-.../v2.0"
tenant_id  = "YOUR_TENANT_ID"
user_name  = "YOUR_USER_NAME"
password   = "YOUR_API_PASSWORD"

vpc_id     = "YOUR_VPC_UUID"
vpc_name   = "YOUR_VPC_NAME"

mgmt_subnet_id    = "MGMT_SUBNET_ID"     #동일 VPC
service_subnet_id = "SERVICE_SUBNET_ID"  #동일 VPC
subnet_id      = "YOUR_SUBNET_UUID"      #동일 VPC
subnet_name    = "YOUR_SUBNET_NAME"
subnet_shared  = false

keypair_name = "YOUR_KEYPAIR_NAME"
flavor_name  = "YOUR_FLAVOR_NAME"
image_name   = "YOUR_IMAGE_NAME"

my_ip_cidr    = "YOUR_PUBLIC_IP/32"
jenkins_allowed_cidr = "JENKINS_PUBLIC_IP/32"

create_floating_ip = true
floating_ip_pool = "YOUR_FIP_POOL"